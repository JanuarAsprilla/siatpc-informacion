---
import SiatHeader from '../components/SiatHeader.astro';
import SiatFooter from '../components/SiatFooter.astro';
import ModuleNav from '../components/ModuleNav.astro';
import '@fontsource-variable/newsreader';
import '../styles/siat.css';
import '../styles/modulo.css';
import '../styles/inicio.css';

interface Props {
  title: string;
  description?: string;
  active?: 'inicio' | 'entidades' | 'documentos' | 'noticias';
}
const { title, description = 'Entidades, documentos y noticias del Sistema de Información Ambiental Territorial del Pacífico.', active } = Astro.props;
const completo = title.startsWith('SIAT') ? title : `${title} · Centro de información · SIAT PC`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{completo}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="https://files.siatpc.co/images/favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <SiatHeader />
    <div class="marco">
      <ModuleNav active={active} />
      <main id="contenido"><slot /></main>
    </div>
    <SiatFooter />
  </body>
</html>
