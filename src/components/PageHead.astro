---
import { ruta } from '../lib/rutas';
import { MODULO } from '../lib/modulo';

interface Miga { t: string; href?: string }
interface Props { titulo: string; lead?: string; migas?: Miga[]; ancho?: boolean }
const { titulo, lead, migas = [], ancho = false } = Astro.props;
---
<section class:list={['pagehead', { 'pagehead--ancho': ancho }]}>
  <div class="mod">
    {migas.length > 0 && (
      <nav class="migas" aria-label="Ruta de navegación">
        <ol>
          <li><a href={ruta('/')}>{MODULO.nombreCorto}</a></li>
          {migas.map((m) => <li>{m.href ? <a href={ruta(m.href)}>{m.t}</a> : <span aria-current="page">{m.t}</span>}</li>)}
        </ol>
      </nav>
    )}
    <h1>{titulo}</h1>
    {lead && <p>{lead}</p>}
  </div>
</section>
