---
import { ruta } from '../lib/rutas';
import type { Entidad } from '../lib/datos';
import { normalizar, resumir } from '../lib/format';
import LogoEntidad from './LogoEntidad.astro';

interface Props { e: Entidad; docs: number }
const { e, docs } = Astro.props;
const resumen = e.acerca ? resumir(e.acerca, 190) : 'Descripción por confirmar con la entidad.';
const buscable = normalizar(`${e.nombre} ${e.sigla} ${e.tipo} ${e.acerca} ${(e.afiliadas ?? []).join(" ")}`);
---
<li data-item data-q={buscable} data-tipo={e.tipo} data-relacion={e.relacion}>
  <article class="tarjeta">
    <div class="ent__logo"><LogoEntidad e={e} /></div>
    <div class="tarjeta__cuerpo">
      <div class="ent__chips"><span class={e.relacion === 'Miembro' ? 'chip chip--verde' : 'chip chip--ambar'}>{e.relacion === 'Miembro' ? 'Miembro del GIC-PA' : 'Entidad relacionada'}</span><span class="chip">{e.tipo}</span></div>
      <h2><a class="stretched-link" href={ruta(`/entidades/${e.slug}/`)}>{e.nombre}</a></h2>
      <p class="recorte">{resumen}</p>
      <div class="tarjeta__pie">
        <span><i class="bi bi-file-earmark-text" aria-hidden="true"></i> {docs} {docs === 1 ? 'documento' : 'documentos'}</span>
        <span class="tarjeta__mas">Ver entidad <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
      </div>
    </div>
  </article>
</li>
