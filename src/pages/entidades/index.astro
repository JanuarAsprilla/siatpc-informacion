---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Toolbar from '../../components/Toolbar.astro';
import EntityCard from '../../components/EntityCard.astro';
import { cuenta, documentosDe, entidades } from '../../lib/datos';

const relaciones = ['Miembro', 'Relacionada'].map((r) => ({ value: r, label: r === 'Miembro' ? 'Miembros del GIC-PA' : 'Entidades relacionadas', count: cuenta(entidades, (e) => e.relacion === r) }));
const tipos =[...new Set(entidades.map((e) => e.tipo))].map((t) => ({ value: t, label: t, count: cuenta(entidades, (e) => e.tipo === t) }));
---
<Base title="Entidades" description="Entidades que integran el GIC-PA y las relacionadas con él." active="entidades">
  <PageHead titulo="Entidades" lead="Las entidades que integran el GIC-PA y las relacionadas con él. Entre a una para conocerla y ver sus documentos." migas={[{ t: 'Entidades' }]} />
  <section class="seccion" style="padding-top:2rem">
    <div class="mod" data-lista data-pagina="30" data-cols="3" data-sustantivo="entidades">
      <Toolbar buscaLabel="Buscar una entidad" buscaPlaceholder="Nombre o sigla" selectores={[{ key: 'relacion', label: 'Relación con el GIC-PA', todas: 'Todas', opciones: relaciones }, { key: 'tipo', label: 'Tipo de entidad', todas: 'Todos los tipos', opciones: tipos }]} />
      <div data-inicio></div>
      <p class="estado" data-estado role="status" aria-live="polite"><span data-resumen></span><button type="button" class="limpiar" data-limpiar hidden>Limpiar filtros</button></p>
      <ul class="rejilla" data-grid data-cols="3">
        {entidades.map((e) => <EntityCard e={e} docs={documentosDe(e.slug).length} />)}
      </ul>
      <p class="vacio" data-vacio hidden>No encontramos entidades con ese filtro. Pruebe con otra palabra o limpie los filtros.<br /><button type="button" class="boton boton--borde boton--sm" data-limpiar>Limpiar filtros</button></p>
      <nav class="paginas" data-paginas aria-label="Páginas de entidades"></nav>
    </div>
  </section>
  <script>import '../../scripts/lista.js';</script>
</Base>
