---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada">
  <section class="seccion">
    <div class="mod" style="text-align:center;padding:3rem 0">
      <h1 style="font-size:2.4rem;color:var(--ink)">No encontramos esa página</h1>
      <p style="color:var(--suave);font-size:1.1rem">Puede que el enlace haya cambiado. Vuelva al inicio o entre a una de las secciones.</p>
      <a class="boton boton--verde" href="/">Ir al inicio</a>
    </div>
  </section>
</Base>
