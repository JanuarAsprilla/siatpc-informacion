---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import DocRow from '../components/DocRow.astro';
import { documentos, entidades, entidadPorSlug, noticias } from '../lib/datos';

const secciones = [
  { t: 'Entidades', d: 'Quiénes hacen parte del Sistema y qué hace cada una.', href: '/entidades/', n: `${entidades.length} entidades` },
  { t: 'Documentos', d: 'Normas, planes e informes de todas las entidades, en un solo lugar.', href: '/documentos/', n: `${documentos.length} documentos` },
  { t: 'Noticias', d: 'Lo que pasa en el territorio y en las entidades.', href: '/noticias/', n: `${noticias.length} noticias` },
];
const [destacada, ...resto] = noticias;
const lado = resto.slice(0, 2);
const fotos = noticias.filter((n) => n.portada).slice(0, 3);
const conLogo = entidades.filter((e) => e.logo);
const recientes = documentos.slice(0, 5);
---
<Base title="SIAT PC · Centro de información" active="inicio">
  <section class="portada">
    <div class="mod">
      <div>
        <h1>Todo lo que las entidades publican, en un solo lugar.</h1>
        <p>Conozca las entidades del Sistema, lea sus documentos y siga las noticias del territorio sin salir del SIAT PC.</p>
        <form class="busca-grande" action="/documentos/" method="get" role="search">
          <label class="sr-only" for="h-q">Buscar documentos</label>
          <input id="h-q" type="search" name="q" placeholder="Buscar un documento: plan, informe, norma…" autocomplete="off" />
          <button class="boton boton--verde" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Buscar</button>
        </form>
      </div>
      <div class="collage" aria-hidden="true">
        {fotos.map((n, i) => <figure class={`c${i + 1}`}><img src={`/${n.portada}`} alt="" width="800" height="800" fetchpriority={i === 0 ? 'high' : undefined} /></figure>)}
      </div>
    </div>
  </section>

  <section class="seccion" aria-label="Secciones del centro de información">
    <div class="mod">
      <ul class="indice">
        {secciones.map((s) => (
          <li><a href={s.href}><span class="indice__titulo">{s.t}</span><span class="indice__desc">{s.d}</span><span class="indice__fin"><span>{s.n}</span><i class="bi bi-arrow-right" aria-hidden="true"></i></span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion seccion--banda">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Últimas noticias</h2>
        <a class="enlace-flecha" href="/noticias/">Ver todas las noticias <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <div class="mosaico">
        <ul><NewsCard n={destacada} variante="grande" /></ul>
        <ul class="mosaico__lado">{lado.map((n) => <NewsCard n={n} variante="fila" />)}</ul>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Documentos recientes</h2>
        <a class="enlace-flecha" href="/documentos/">Ver todos los documentos <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <ul class="filas">{recientes.map((d) => <DocRow d={d} e={entidadPorSlug(d.entidad)!} />)}</ul>
    </div>
  </section>

  <section class="seccion seccion--banda">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Entidades</h2>
        <a class="enlace-flecha" href="/entidades/">Ver todas las entidades <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <ul class="muro">
        {conLogo.map((e) => <li><a href={`/entidades/${e.slug}/`}><img src={e.logo!} alt="" loading="lazy" />{e.sigla}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
