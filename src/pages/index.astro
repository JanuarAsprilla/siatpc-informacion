---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import DocRow from '../components/DocRow.astro';
import LogoEntidad from '../components/LogoEntidad.astro';
import { documentos, entidades, entidadPorSlug, noticias } from '../lib/datos';
import { MODULO } from '../lib/modulo';

const secciones = [
  { t: 'Entidades', d: 'Las entidades que integran el GIC-PA y las relacionadas con él.', href: '/entidades/', n: `${entidades.length} entidades` },
  { t: 'Documentos', d: 'Publicaciones, casos de estudio, fallos y normas sobre el GIC-PA.', href: '/documentos/', n: `${documentos.length} documentos` },
  { t: 'Noticias', d: 'Lo que se publica sobre el GIC-PA y la pesca artesanal del Pacífico norte chocoano.', href: '/noticias/', n: `${noticias.length} noticias` },
];
const [destacada, ...resto] = noticias;
const lado = resto.slice(0, 2);
const fotos = noticias.filter((n) => n.portada).slice(0, 3);
const recientes = documentos.slice(0, 5);
---
<Base title={MODULO.nombre} active="inicio">
  <section class="portada">
    <div class="mod">
      <div>
        <h1>{MODULO.nombre}</h1>
        <p>{MODULO.nombreLargo}: conozca las entidades que lo integran, lea sus documentos y siga sus noticias.</p>
        {MODULO.sufijo && <p class="aviso-prueba"><i class="bi bi-info-circle" aria-hidden="true"></i> Versión de {MODULO.sufijo}: todavía no está integrada al SIAT PC.</p>}
        <form class="busca-grande" action="/documentos/" method="get" role="search">
          <label class="sr-only" for="h-q">Buscar documentos</label>
          <input id="h-q" type="search" name="q" placeholder="Buscar un documento: plan, informe, norma…" autocomplete="off" />
          <button class="boton boton--verde" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Buscar</button>
        </form>
      </div>
      <div class="collage" aria-hidden="true">
        {fotos.map((n, i) => <figure class={`c${i + 1}`}><img src={`/${n.portada}`} alt="" width="800" height="800" fetchpriority={i === 0 ? 'high' : undefined} /></figure>)}
      </div>
    </div>
  </section>

  <section class="seccion" aria-label="Secciones del centro de información">
    <div class="mod">
      <ul class="indice">
        {secciones.map((s) => (
          <li><a href={s.href}><span class="indice__titulo">{s.t}</span><span class="indice__desc">{s.d}</span><span class="indice__fin"><span>{s.n}</span><i class="bi bi-arrow-right" aria-hidden="true"></i></span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion que-es" aria-labelledby="t-que-es">
    <div class="mod">
      <div class="que-es__grid">
        <div>
          <h2 id="t-que-es">Qué es el GIC-PA</h2>
          <p class="que-es__cita">«Ordenar la actividad pesquera artesanal de la costa chocoana, como una estrategia para la recuperación del recurso pesquero y el fortalecimiento de la actividad pesquera artesanal de la región.»</p>
          <p class="que-es__fuente">Objetivo con el que se creó, según la publicación de <a href="https://marviva.net/wp-content/uploads/2021/11/publicacion_gicpa_final_8-02-17-1.pdf" target="_blank" rel="noopener noreferrer">MarViva y el GIC-PA (2016)</a>.</p>
        </div>
        <dl class="que-es__datos">
          <div><dt>Origen</dt><dd>Se creó en 1998 en el Parque Nacional Natural Utría, por iniciativa de pescadores artesanales de Juradó, Bahía Solano y Nuquí.</dd></div>
          <div><dt>Territorio</dt><dd>Cinco municipios costeros del Pacífico chocoano: Litoral del San Juan, Pizarro, Nuquí, Bahía Solano y Juradó.</dd></div>
          <div><dt>Quiénes lo integran</dt><dd>Autoridades, sector productivo (pescadores, comercializadores y asociaciones) y entidades de apoyo (universidades, institutos y ONG). En 2016 la lista de miembros superaba los 80.</dd></div>
          <div><dt>Logros documentados</dt><dd>La Zona Exclusiva de Pesca Artesanal (ZEPA) y el Distrito Regional de Manejo Integrado Golfo de Tribugá-Cabo Corrientes.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="seccion seccion--banda">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Últimas noticias</h2>
        <a class="enlace-flecha" href="/noticias/">Ver todas las noticias <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <div class="mosaico">
        <ul><NewsCard n={destacada} variante="grande" /></ul>
        <ul class="mosaico__lado">{lado.map((n) => <NewsCard n={n} variante="fila" />)}</ul>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Documentos recientes</h2>
        <a class="enlace-flecha" href="/documentos/">Ver todos los documentos <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <ul class="filas">{recientes.map((d) => <DocRow d={d} e={entidadPorSlug(d.entidad)!} />)}</ul>
    </div>
  </section>

  <section class="seccion seccion--banda">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Entidades</h2>
        <a class="enlace-flecha" href="/entidades/">Ver todas las entidades <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <ul class="muro">
        {entidades.map((e) => <li><a href={`/entidades/${e.slug}/`}><span class="muro__logo"><LogoEntidad e={e} /></span><span class="muro__sigla">{e.sigla}</span></a></li>)}
      </ul>
    </div>
  </section>
</Base>
