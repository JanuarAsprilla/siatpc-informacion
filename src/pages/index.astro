---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import DocCard from '../components/DocCard.astro';
import { documentos, entidades, entidadPorSlug, noticias } from '../lib/datos';

const accesos = [
  { t: 'Entidades', d: 'Quiénes hacen parte y qué hace cada una.', href: '/entidades/', n: entidades.length, icono: 'bi-buildings', c: 'var(--verde)' },
  { t: 'Documentos', d: 'Normas, planes e informes de todas las entidades.', href: '/documentos/', n: documentos.length, icono: 'bi-file-earmark-text', c: 'var(--azul)' },
  { t: 'Noticias', d: 'Lo que pasa en el territorio y en las entidades.', href: '/noticias/', n: noticias.length, icono: 'bi-newspaper', c: 'var(--naranja)' },
];
const recientesNoticias = noticias.slice(0, 3);
const recientesDocs = documentos.slice(0, 3);
---
<Base title="SIAT PC · Centro de información" active="inicio">
  <section class="hero">
    <div class="mod">
      <span class="hero__etiqueta"><i class="bi bi-compass" aria-hidden="true"></i> Sistema de Información Ambiental Territorial del Pacífico</span>
      <h1>Todo lo que las entidades publican, en un solo lugar.</h1>
      <p>Consulte las entidades del Sistema, lea sus documentos y siga las noticias del territorio sin salir del SIAT PC.</p>
      <form class="hero__busca" action="/documentos/" method="get" role="search">
        <label class="sr-only" for="h-q">Buscar documentos</label>
        <input id="h-q" type="search" name="q" placeholder="Buscar un documento: plan, informe, norma…" autocomplete="off" />
        <button class="boton boton--verde" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Buscar</button>
      </form>
    </div>
  </section>

  <section class="accesos" aria-label="Secciones del centro de información">
    <div class="mod">
      <ul>
        {accesos.map((a) => (
          <li>
            <a class="acceso" href={a.href} style={`--c:${a.c}`}>
              <i class={`bi ${a.icono}`} aria-hidden="true"></i>
              <strong>{a.t}</strong>
              <span>{a.d}</span>
              <b>{a.n}</b>
            </a>
          </li>
        ))}
        <li>
          <a class="acceso" href="https://siatpc.co/" style="--c: var(--marino)">
            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
            <strong>SIAT PC</strong>
            <span>Volver al sitio principal del sistema.</span>
            <b aria-hidden="true">→</b>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="seccion">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Últimas noticias</h2>
        <a class="enlace-flecha" href="/noticias/">Ver todas las noticias <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <ul class="rejilla" data-cols="3">
        {recientesNoticias.map((n) => <NewsCard n={n} />)}
      </ul>
    </div>
  </section>

  <section class="seccion seccion--banda">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Entidades</h2>
        <a class="enlace-flecha" href="/entidades/">Ver todas las entidades <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <ul class="logos">
        {entidades.filter((e) => e.logo).map((e) => (
          <li><a href={`/entidades/${e.slug}/`}><img src={e.logo!} alt="" loading="lazy" />{e.sigla}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Documentos recientes</h2>
        <a class="enlace-flecha" href="/documentos/">Ver todos los documentos <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <ul class="rejilla" data-cols="3">
        {recientesDocs.map((d) => <DocCard d={d} e={entidadPorSlug(d.entidad)!} />)}
      </ul>
    </div>
  </section>
</Base>
