---
import { ruta } from '../lib/rutas';
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import DocRow from '../components/DocRow.astro';
import LogoEntidad from '../components/LogoEntidad.astro';
import Storymap from '../components/storymap/Storymap.astro';
import { documentos, entidades, entidadPorSlug, noticias } from '../lib/datos';
import inicio from '../data/inicio.json';
import { MODULO } from '../lib/modulo';

const [destacada, ...resto] = noticias;
const lado = resto.slice(0, 2);
// Fotos del collage: independientes de las noticias, en el orden de src/data/inicio.json (1.ª grande, 2.ª arriba, 3.ª redonda).
const fotos = inicio.collage.slice(0, 3);
const recientes = documentos.slice(0, 5);
---
<Base title={MODULO.nombre} active="inicio">
  <section class="portada">
    <div class="mod">
      <div>
        <h1>{MODULO.nombre}</h1>
        <p class="saludo">{MODULO.presentacion.saludo}</p>
        {MODULO.presentacion.parrafos.map((t) => <p>{t}</p>)}
        {MODULO.sufijo && <p class="aviso-prueba"><i class="bi bi-info-circle" aria-hidden="true"></i> Versión de {MODULO.sufijo}: todavía no está integrada al SIAT PC.</p>}
        <form class="busca-grande" action={ruta('/documentos/')} method="get" role="search">
          <label class="sr-only" for="h-q">Buscar documentos</label>
          <input id="h-q" type="search" name="q" placeholder="Buscar un documento: plan, informe, norma…" autocomplete="off" />
          <button class="boton boton--verde" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Buscar</button>
        </form>
      </div>
      <div class="collage" aria-hidden="true">
        {fotos.map((src, i) => <figure class={`c${i + 1}`}><img src={ruta(`/${src}`)} alt="" width="800" height="800" fetchpriority={i === 0 ? 'high' : undefined} /></figure>)}
      </div>
    </div>
  </section>

  <Storymap />

  <section class="seccion seccion--banda">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Últimas noticias</h2>
        <a class="enlace-flecha" href={ruta('/noticias/')}>Ver todas las noticias <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <div class="mosaico">
        <ul><NewsCard n={destacada} variante="grande" /></ul>
        <ul class="mosaico__lado">{lado.map((n) => <NewsCard n={n} variante="fila" />)}</ul>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Documentos recientes</h2>
        <a class="enlace-flecha" href={ruta('/documentos/')}>Ver todos los documentos <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <ul class="filas">{recientes.map((d) => <DocRow d={d} e={entidadPorSlug(d.entidad)!} />)}</ul>
    </div>
  </section>

  <section class="seccion seccion--banda">
    <div class="mod">
      <div class="seccion__cab">
        <h2>Entidades</h2>
        <a class="enlace-flecha" href={ruta('/entidades/')}>Ver todas las entidades <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
      <ul class="muro">
        {entidades.map((e) => <li><a href={ruta(`/entidades/${e.slug}/`)}><span class="muro__logo"><LogoEntidad e={e} /></span><span class="muro__sigla">{e.sigla}</span></a></li>)}
      </ul>
    </div>
  </section>
</Base>
